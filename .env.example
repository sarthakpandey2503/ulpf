# ULPF sample environment file.
#
# Copy to .env in the project root and edit:
#   PowerShell: copy .env.example .env
#   bash/zsh:   cp .env.example .env
#
# Only ULPF_* names are read. Variables already set in the process environment
# (shell export, Docker, Compose) take precedence over this file.
# Uncomment a line to override its default. Never commit the real .env.

# --- Paths ---
# ULPF_DATA_DIR=./data
# ULPF_PACKS_DIR=./ulpf/packs/library
# ULPF_DRAFTS_DIR=./data/drafts
# ULPF_APPROVED_PACKS_DIR=./data/packs
# ULPF_KEYS_DIR=./data/keys
# ULPF_TOKENS_FILE=./data/tokens.json
# ULPF_UI_DIR=./ui
# ULPF_SAMPLES_DIR=./samples

# --- Input hardening ---
# ULPF_MAX_LINE_BYTES=65536
# ULPF_MAX_JSON_DEPTH=32
# ULPF_MAX_FIELDS=1024
# ULPF_MAX_HTTP_BATCH=5000
# ULPF_RATE_LIMIT_EPS=50000
# ULPF_MAX_BODY_BYTES=8000000

# --- Lineage and packs ---
# ULPF_BATCH_SIZE=256
# ULPF_REQUIRE_SIGNED_PACKS=false

# --- Transport and sinks ---
# ULPF_BUS=memory
# ULPF_KAFKA_BOOTSTRAP=localhost:9092
# ULPF_SINKS=sqlite
# ULPF_CLICKHOUSE_URL=http://localhost:8123
# ULPF_S3_ENDPOINT=
# ULPF_S3_BUCKET=ulpf-lake
# ULPF_SPLUNK_HEC_URL=
# ULPF_ELASTIC_URL=
# ULPF_CEF_FORWARD=
# ULPF_TLS_VERIFY=true

# --- Sink secrets (each also accepts ULPF_<NAME>_FILE pointing at a file) ---
# ULPF_CLICKHOUSE_PASSWORD=
# ULPF_SPLUNK_HEC_TOKEN=
# ULPF_ELASTIC_API_KEY=
# ULPF_S3_ACCESS_KEY=
# ULPF_S3_SECRET_KEY=

# --- Local LLM for the parser generator: Ollama (default) ---
# ULPF_OLLAMA_URL=http://localhost:11434
# ULPF_OLLAMA_MODEL=qwen2.5-coder:7b
# ULPF_OLLAMA_ALLOWED_HOSTS=localhost,127.0.0.1,::1,ollama

# --- Local LLM: LM Studio ---
# Setting ULPF_LMSTUDIO_API_KEY switches the generator from Ollama to LM Studio.
# ULPF_LMSTUDIO_MODEL is required then (the model id shown by LM Studio's /v1/models).
# The URL host must still be in ULPF_OLLAMA_ALLOWED_HOSTS.
# ULPF_LMSTUDIO_API_KEY=lm-studio
# ULPF_LMSTUDIO_URL=http://127.0.0.1:1234/v1
# ULPF_LMSTUDIO_MODEL=qwen2.5-coder-7b-instruct
# "none" turns off hidden reasoning on thinking models (otherwise they can use the
# whole token budget and return no JSON). Leave empty to omit the field.
# ULPF_LMSTUDIO_REASONING_EFFORT=none

# --- API and dashboard ---
# ULPF_CORS_ORIGINS=
# ULPF_DEMO=false
# ULPF_HSTS=false
